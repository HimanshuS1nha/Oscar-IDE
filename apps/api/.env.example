# The MySQL database, e.g. mysql://user:password@localhost:3306/oscar
DATABASE_URL=
# Signs sign-in tokens. Any long random string, e.g. from `openssl rand -base64 32`.
JWT_SECRET=

# AI providers, read by the TanStack AI adapters. Set the ones you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Web search and page reading for the AI (read by the Firecrawl SDK). Optional.
FIRECRAWL_API_KEY=

# Each user's AI budget per day, in dollars. Optional, default 10.
DAILY_BUDGET_USD=
